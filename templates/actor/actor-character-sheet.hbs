<form class="knave-document document-character {{cssClass}} {{actor.type}}" autocomplete="off">
    <div class="document-masthead">
        <span class="document-edition">KNAVE <span aria-hidden="true">/</span> II</span>
        <div><p class="document-kicker">{{localize "KNAVE2E.Document.character.Subtitle"}}</p>
        <h1>{{localize "KNAVE2E.Document.character.Title"}}</h1></div>
        <span class="document-folio" aria-hidden="true">I</span>
    </div>
    <div class="sheet-container">
        <div class="character-grid">

            {{!-- Sheet Header --}}
            <header class="header">

                {{!-- Knave Logo --}}
                <div class="logo">
                    <img class="logo-img no-border" src="systems/knave2e/assets/knave-2e-logo.webp" alt="Knave Second Edition" />
                </div>

                {{!-- Character Header Info --}}
                <div class="info">
                    <div class="flexrow no-wrap flex-between flex-group-left dotted name">
                        <div class="resource-label flex1">{{localize "KNAVE2E.Name"}}</div>
                        <input class="transparent flex3 no-border detail name" name="name" type="text"
                            value="{{actor.name}}" placeholder="{{actor.name}}" />
                    </div>
                    <div class="flexrow no-wrap flex-between flex-group-left dotted careers">
                        <div class="resource-label flex1">{{localize "KNAVE2E.Careers"}}</div>
                        <input class="transparent flex3 no-border detail" name="system.careers" type="text"
                            value="{{system.careers}}" placeholder="Alchemist, Cook, Sailor, etc." />
                    </div>
                    <div class="flexrow no-wrap flex-between flex-group-center stats" style="margin-top: 5px;">
                        <div class="flexcol no-wrap flex-group-center companions">
                            <div class="resource-label">{{localize "KNAVE2E.Companions"}}</div>
                            <input class="resource-label content narrow" type="text" name="system.companions.value"
                                value="{{system.companions.value}}" data-dtype="Number" />
                        </div>
                        <div class="flexcol no-wrap flex-group-center movement">
                            <div class="resource-label">{{localize "KNAVE2E.Movement"}}</div>
                            <input class="resource-label content narrow" type="text" name="system.movement"
                                value="{{system.movement}}" data-dtype="Number" />
                        </div>
                        <div class="flexcol no-wrap flex-group-center coins">
                            <div class="resource-label">{{localize "KNAVE2E.Coins"}}</div>
                            <input class="resource-label content narrow" type="text" name="system.coins"
                                value="{{system.coins}}" data-dtype="Number" />
                        </div>
                    </div>
                </div>
            </header>

            {{!-- Sheet Tab Navigation --}}
            <nav class="sheet-tabs tabs resource-label document-bookmarks" aria-label="{{localize 'KNAVE2E.Character'}}" data-group="primary">
                {{!-- Default tab is specified in actor-sheet.mjs --}}
                <a class="item tab-color resource-label" data-tab="character" role="button" tabindex="0"><span class="bookmark-index" aria-hidden="true">I</span><span>{{localize "KNAVE2E.Character"}}</span></a>
                <a class="item tab-color resource-label" data-tab="items" role="button" tabindex="0"><span class="bookmark-index" aria-hidden="true">II</span><span>{{localize "KNAVE2E.Inventory"}}</span></a>
                <a class="item tab-color resource-label" data-tab="description" role="button" tabindex="0"><span class="bookmark-index" aria-hidden="true">III</span><span>{{localize "KNAVE2E.Description"}}</span></a>
            </nav>

            {{!-- Sheet Body --}}
            <section class="sheet-body">
                {{!-- Character Tab --}}
                <div class="tab character" data-group="primary" data-tab="character">
                    {{!-- Abilities --}}
                    <div class="abilities">
                        {{#each system.abilities as |ability key|}}
                        <div class="flexrow no-wrap flex-between">
                            <input class="resource-label flex1 flex-group-center circle character" type="text"
                                aria-label="{{localize ability.label}}" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number" />
                            <div class="ability flex3 flex-group-left">
                                <button type="button" class="resource-label flexrow no-wrap rollable flex-start"
                                    data-roll="d20+@abilities.{{key}}.value" data-label="{{ability.label}}"
                                    style="justify-content:left;font-size:20px;">
                                    {{localize
                                    ability.label}}
                                </button>
                                <div class="flexrow no-wrap flex-start detail italic">
                                    {{{localize
                                    ability.detail}}}
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>

                    {{! -- Armor -- !}}
                    <div class="armor flexrow no-wrap">
                        <div class="flexcol no-wrap flex-group-center">
                            <div class="resource-label">{{localize "KNAVE2E.ArmorClass"}}</div>
                            {{#if system.settings.automaticArmor}}
                            <div class="resource-label shield character">{{system.armorClass}}</div>
                            {{else}}
                            <input class="resource-label content shield character" type="text" name="system.armorClass"
                                value="{{system.armorClass}}" data-dtype="Number" />
                            {{/if}}
                        </div>
                        <div class="flexcol no-wrap flex-group-center">
                            <a class="resource-label transparent actor-button ap">{{localize "KNAVE2E.ArmorPoints"}}</a>
                            {{#if system.settings.automaticArmor}}
                            <div class="resource-label circle character">{{system.armorPoints}}</div>
                            {{else}}
                            <input class="resource-label content circle character" type="text" name="system.armorPoints"
                                value="{{system.armorPoints}}" data-dtype="Number" />
                            {{/if}}
                        </div>
                    </div>

                    {{!-- Handwritten vital signs: all original field names are preserved. --}}
                    <div class="health">
                        <div class="vital-note">
                            <img class="vital-illustration" src="systems/knave2e/assets/ink-heart.webp" alt="" aria-hidden="true" />
                            <div class="vital-values">
                                <label class="resource-label" for="{{appId}}-hp">{{localize "KNAVE2E.HitPoints"}}</label>
                                <input id="{{appId}}-hp" class="ink-number" aria-label="{{localize 'KNAVE2E.HitPoints'}}" name="system.hitPoints.value" value="{{system.hitPoints.value}}" />
                                <label class="resource-label aside" for="{{appId}}-hp-max">{{localize "KNAVE2E.HitPointsMax"}}</label>
                                <input id="{{appId}}-hp-max" class="ink-number small" name="system.hitPoints.max" value="{{system.hitPoints.max}}" />
                            </div>
                        </div>
                        <div class="wound-note">
                            <label class="resource-label" for="{{appId}}-wounds">{{localize "KNAVE2E.Wounds"}}</label>
                            <div class="wound-values">
                                <input id="{{appId}}-wounds" class="ink-number" aria-label="{{localize 'KNAVE2E.Wounds'}}" name="system.wounds.value" value="{{system.wounds.value}}" />
                                <span aria-hidden="true">/</span>
                                {{#if system.settings.automaticWounds}}
                                <span class="ink-number small" title="{{localize 'KNAVE2E.WoundsMax'}}">{{system.wounds.max}}</span>
                                {{else}}
                                <input class="ink-number small" type="text" name="system.wounds.max" value="{{system.wounds.max}}" data-dtype="Number" aria-label="{{localize 'KNAVE2E.WoundsMax'}}" />
                                {{/if}}
                            </div>
                        </div>
                        <div class="health-rest">
                            <button class="resource-label rounded transparent actor-button rest" type="button">{{localize "KNAVE2E.Rest"}}</button>
                        </div>
                    </div>

                    {{!-- Advancement --}}
                    <div class="level flexrow no-wrap">
                        <div class="flexcol no-wrap flex-group-center">
                            <div class="resource-label">{{localize "KNAVE2E.Level"}}</div>
                                    {{#if system.settings.automaticLevel}}
                                    <div class="resource-label rounded character">{{system.level}}</div>
                                    {{else}}
                                    <input class="resource-label narrow content rounded character" type="text"
                                        name="system.level" value="{{system.level}}" data-dtype="Number" />
                                    {{/if}}
                        </div>
                        <div class="xp flex-group-left">
                            <div class="resource-label">&nbsp;{{localize "KNAVE2E.XP"}}</div>
                            <div class="progress-container horizontal">
                                <div class="progress-bar">
                                    <div class="progress-fill xp" style="width:{{system.xp.progress}}%"></div>
                                    <input class="progress-input resource-label content" aria-label="{{localize 'KNAVE2E.XP'}}" name="system.xp.value"
                                        value="{{system.xp.value}}" />
                                </div>
                            </div>
                        </div>
                    </div>

                    {{!-- Portrait --}}
                    <div class="portrait">
                        <div class="flexcol no-wrap">
                            <div class="resource-label align-center">{{localize "KNAVE2E.Portrait"}}</div>
                            <img class="rounded" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"
                                width="100%" />
                        </div>
                    </div>
                </div>

                {{!-- Item Slots Tab --}}
                <div class="tab items" data-group="primary" data-tab="items">
                    {{> "systems/knave2e/templates/actor/parts/actor-character-items.hbs"}}
                </div>

                {{!-- Description Tab --}}
                <div class="tab description" data-group="primary" data-tab="description">
                    <div class="journal-heading"><img src="systems/knave2e/assets/ink-journal.webp" alt="" aria-hidden="true" /><span>{{localize "KNAVE2E.Description"}}</span></div>
                    <section class="editor">
                        {{editor system.enrichedHTML target="system.description" button=true owner=owner
                        editable=editable}}
                    </section>
                </div>

            </section>
            <footer class="footer">
                <div class="flexrow no-wrap flex-group-center ">
                    <p style="font-size:smaller">Copyright &#169; 2023 <a
                            href="https://www.patreon.com/questingbeast/posts">Ben
                            Milton and Questing Beast LLC.</a> Logo Design by <a
                            href="https://www.behance.net/MindkillerINK?locale=en_US">Tim Hastings</a>.</p>
                </div>
            </footer>
        </div>
    </div>
</form>